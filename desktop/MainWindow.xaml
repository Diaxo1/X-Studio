<Window x:Class="XStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="X Studio" Width="1280" Height="820" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#111214" Foreground="#F3F2EF"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#111214"/>
        <SolidColorBrush x:Key="Side" Color="#17181B"/>
        <SolidColorBrush x:Key="Surface" Color="#191A1D"/>
        <SolidColorBrush x:Key="Surface2" Color="#222327"/>
        <SolidColorBrush x:Key="Line" Color="#38393F"/>
        <SolidColorBrush x:Key="Muted" Color="#999A9E"/>
        <SolidColorBrush x:Key="Accent" Color="#F04455"/>
        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Foreground" Value="#C7C7C5"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,3"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="#222327"/></Trigger><Trigger Property="Tag" Value="Active"><Setter TargetName="NavBg" Property="Background" Value="#321C21"/><Setter Property="Foreground" Value="#FF6978"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,0"/><Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="PrimaryBg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PrimaryBg" Property="Background" Value="#FF6371"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="PrimaryBg" Property="Opacity" Value=".55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Foreground" Value="#E5E5E6"/><Setter Property="Background" Value="#222327"/><Setter Property="BorderBrush" Value="#38393F"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,0"/><Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="SecondaryBg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SecondaryBg" Property="BorderBrush" Value="#F04455"/><Setter TargetName="SecondaryBg" Property="Background" Value="#292327"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#222327"/><Setter Property="BorderBrush" Value="#38393F"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#F04455"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#222327"/><Setter Property="BorderBrush" Value="#38393F"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="DropButton" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBg" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}" CornerRadius="5"><Grid><ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" HorizontalAlignment="Left"/><TextBlock Text="⌄" Foreground="#BFC0C4" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,1"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#222327" BorderBrush="#55565C" BorderThickness="1" CornerRadius="5" MaxHeight="{TemplateBinding MaxDropDownHeight}"><ScrollViewer Margin="2" SnapsToDevicePixels="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".52"/></Trigger><Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="DropButton" Property="Opacity" Value=".92"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F3F2EF"/><Setter Property="Background" Value="#222327"/><Setter Property="Padding" Value="9,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#383035"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBg" Property="Background" Value="#F04455"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C7C7C5"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border x:Name="CheckBoxBorder" Width="16" Height="16" CornerRadius="4" BorderBrush="#55565C" BorderThickness="1" Background="#222327" Margin="0,0,7,0"><TextBlock x:Name="CheckMark" Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckBoxBorder" Property="Background" Value="#F04455"/><Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#F04455"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckBoxBorder" Property="BorderBrush" Value="#FF6371"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0" Background="{StaticResource Side}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="16,22,16,0">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,36">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Accent}" Margin="0,0,10,0"><TextBlock Text="X" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="X STUDIO" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="LOCAL" Foreground="#85868B" FontSize="9" Margin="7,2,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="YOUR STUDIO" Foreground="#85868B" FontSize="10" Margin="10,0,0,8"/>
                <Button x:Name="LiveNav" Style="{StaticResource NavButton}" Tag="Active" Click="ShowLivePage"><StackPanel Orientation="Horizontal"><TextBlock Text="▤" Foreground="{StaticResource Accent}" Width="24"/><TextBlock Text="Live desk"/></StackPanel></Button>
                <Button x:Name="DestinationsNav" Style="{StaticResource NavButton}" Click="ShowDestinationsPage"><StackPanel Orientation="Horizontal"><TextBlock Text="↗" Width="24"/><TextBlock Text="Destinations"/></StackPanel></Button>
                <Button x:Name="ScenesNav" Style="{StaticResource NavButton}" Click="ShowScenesPage"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" Width="24"/><TextBlock Text="Scene library"/></StackPanel></Button>
                <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="ShowSettingsPage"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" Width="24"/><TextBlock Text="Settings"/></StackPanel></Button>
                <Button Style="{StaticResource NavButton}" Click="ShowAboutPage"><StackPanel Orientation="Horizontal"><TextBlock Text="◌" Width="24"/><TextBlock Text="Engine status"/></StackPanel></Button>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,17">
                <Border Background="#222327" BorderBrush="#38393F" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="◌" Foreground="#F04455" FontSize="18" Margin="0,0,9,0"/><StackPanel><TextBlock Text="Quiet profile" FontSize="11" FontWeight="SemiBold"/><TextBlock Text="720p · 30 fps" Foreground="#999A9E" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
                </Border>
                <TextBlock Text="X STUDIO  ·  ENGINE SPIKE" Foreground="#77787E" FontSize="9" Margin="5,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="#2D2E33" BorderThickness="0,0,0,1" Padding="26,0">
                <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><TextBlock Text="CONTROL ROOM" Foreground="#999A9E" FontSize="10"/><TextBlock Text="LIVE DESK" Foreground="#F3F2EF" FontSize="10" FontWeight="SemiBold" Margin="14,0,0,0"/></StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="#A0A1A5" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="EngineStatusText" Text="Engine idle" Foreground="#C7C7C5" FontSize="11"/><TextBlock Text="X" Foreground="#F04455" FontWeight="Bold" Margin="18,0,0,0"/></StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Row="1" Margin="26,18,26,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <StackPanel x:Name="LivePage" Visibility="Visible">
                            <DockPanel Margin="0,0,0,14" LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center"><TextBlock Text="Stream control" FontSize="22" FontWeight="Bold"/><TextBlock Text="Capture, arrange your scene, choose outputs." Foreground="#999A9E" FontSize="12" Margin="0,3,0,0"/></StackPanel>
                                <Button x:Name="StartStopButton" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="StartStopClick" MinWidth="154" Content="◉  Start broadcast" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,0,0,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="ON AIR SETUP" Foreground="#FF6978" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,12,0"/>
                                    <ComboBox x:Name="ActiveSceneCombo" Grid.Column="1" Height="34" ToolTip="Choose active scene" SelectionChanged="ActiveSceneChanged"/>
                                    <TextBlock Grid.Column="2" Text="CAPTURE" Foreground="#999A9E" FontSize="9" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox x:Name="LiveCaptureTargetCombo" Grid.Column="3" Height="34" MinWidth="150" ToolTip="Choose full screen or an open app window for the scene capture source." SelectionChanged="LiveCaptureTargetChanged"/>
                                    <TextBlock Grid.Column="4" Text="CAM" Foreground="#999A9E" FontSize="9" VerticalAlignment="Center" Margin="12,0,8,0"/>
                                    <ComboBox x:Name="LiveCameraCombo" Grid.Column="5" Height="34" ToolTip="Choose camera" SelectionChanged="LiveCameraChanged"/>
                                    <Button Grid.Column="6" Content="＋ Scene" Style="{StaticResource SecondaryButton}" Click="AddSceneClick" Margin="8,0,0,0"/>
                                    <Button Grid.Column="7" Content="Templates" Style="{StaticResource SecondaryButton}" Click="NewSceneClick" Margin="6,0,0,0"/>
                                    <Button Grid.Column="8" Content="＋ Source" Style="{StaticResource SecondaryButton}" Click="AddSourceToActiveSceneClick" Margin="6,0,0,0"/>
                                </Grid>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width=".95*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,12,0">
                                    <StackPanel>
                                        <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="01 / MONITOR" Foreground="#999A9E" FontSize="10"/><TextBlock Text="Live scene preview" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="PreviewStatusText" Text="Starting preview…" Foreground="#999A9E" FontSize="9" Margin="0,2,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="WidePreviewButton" Content="Wide · 16:9" Style="{StaticResource SecondaryButton}" Click="WidePreviewClick" Margin="0,0,6,0" ToolTip="Preview the wide output layout"/><Button x:Name="TikTokPreviewButton" Content="TikTok · 9:16" Style="{StaticResource SecondaryButton}" Click="TikTokPreviewClick" Margin="0,0,6,0" ToolTip="Preview the portrait TikTok output layout"/><Button x:Name="CropModeButton" Content="Crop: off" Style="{StaticResource SecondaryButton}" Click="ToggleCropModeClick" ToolTip="Turn on to drag the edges of a selected capture or media layer"/></StackPanel></DockPanel>
                                        <Border x:Name="PreviewFrame" Height="380" Margin="0,12,0,0" Background="#090A0C" BorderBrush="#38393F" BorderThickness="1" CornerRadius="7" HorizontalAlignment="Stretch">
                                            <Grid><Canvas x:Name="ScenePreviewCanvas" Background="#111214" ClipToBounds="True" Focusable="True" KeyDown="PreviewCanvasKeyDown" MouseLeftButtonDown="PreviewSourceMouseDown" MouseMove="PreviewSourceMouseMove" MouseLeftButtonUp="PreviewSourceMouseUp" SizeChanged="PreviewCanvasSizeChanged"/>
                                                <DockPanel VerticalAlignment="Bottom" Margin="10" IsHitTestVisible="False"><TextBlock Text="●  LIVE CANVAS" Foreground="#F04455" FontSize="9"/><TextBlock Text="CLICK · DRAG · RESIZE CORNERS · DEL REMOVE" Foreground="#E2E2E4" FontSize="8" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel>
                                            </Grid>
                                        </Border>
                                        <DockPanel Margin="0,11,0,0"><StackPanel Orientation="Horizontal"><Border Width="35" Height="26" CornerRadius="4" Background="#292A2E"><TextBlock Text="01" Foreground="#F04455" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/></Border><StackPanel Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="ACTIVE SCENE" Foreground="#999A9E" FontSize="9"/><TextBlock x:Name="ActiveSceneText" Text="Starting soon" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock x:Name="CaptureStatusText" Text="Ready for capture" Foreground="#999A9E" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="14">
                                        <StackPanel><DockPanel><StackPanel><TextBlock Text="02 / DESTINATIONS" Foreground="#999A9E" FontSize="10"/><TextBlock Text="Send your stream to" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel><Button Content="Manage" Style="{StaticResource SecondaryButton}" Click="ShowDestinationsPage" DockPanel.Dock="Right" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="NoDestinationText" Text="Add a destination to get started." Foreground="#999A9E" FontSize="11" Margin="0,10,0,0"/><ItemsControl x:Name="LiveDestinationList" Margin="0,8,0,0"/><Button Content="＋  Add destination" Style="{StaticResource SecondaryButton}" Click="AddDestinationClick" Margin="0,9,0,0" HorizontalAlignment="Stretch"/></StackPanel>
                                    </Border>
                                    <Border Background="#1B1C20" BorderBrush="#38393F" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,12,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="75"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="46" Height="78" CornerRadius="9" BorderBrush="#85868B" BorderThickness="1" Background="#151619" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="⌁" Foreground="#F04455" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"><DockPanel><TextBlock Text="PHONE INPUT" Foreground="#F04455" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="PhoneDeskStatus" Text="NOT CONNECTED" Foreground="#999A9E" FontSize="9" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Bring your phone on set." FontSize="14" FontWeight="SemiBold" Margin="0,4,0,7"/><WrapPanel><Button Content="Android · USB" Style="{StaticResource SecondaryButton}" Height="29" Click="StartAndroidCastClick" Margin="0,0,6,0"/><Button Content="iPhone · AirPlay" Style="{StaticResource SecondaryButton}" Height="29" Click="StartIPhoneCastClick"/></WrapPanel><TextBlock x:Name="PhoneDeskHint" Text="Connect a phone, then add its source to the scene." Foreground="#999A9E" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,12,0"><StackPanel><TextBlock Text="03 / AUDIO INPUT" Foreground="#999A9E" FontSize="10"/><DockPanel Margin="0,8,0,0"><TextBlock Text="Microphone" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="MicrophoneEnabled" Content="Include mic" IsChecked="True" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="MicrophoneToggleChanged" Unchecked="MicrophoneToggleChanged"/></DockPanel><ComboBox x:Name="AudioDeviceCombo" Height="34" Margin="0,8,0,0" IsEditable="False" SelectionChanged="AudioDeviceChanged"/><DockPanel Margin="0,8,0,0"><Button x:Name="MicTestButton" Content="Test microphone" Style="{StaticResource SecondaryButton}" Height="28" Click="MicTestClick"/><TextBlock x:Name="MicTestStatus" Text="Ready to test" Foreground="#999A9E" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel><Border x:Name="MicMeterTrack" Height="6" Background="#303136" CornerRadius="3" Margin="0,7,0,0" ClipToBounds="True"><Border x:Name="MicMeterFill" Width="0" HorizontalAlignment="Left" Background="#F04455" CornerRadius="3"/></Border><TextBlock Text="Speak to check the live input meter. X Studio checks the mic again before a broadcast." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="Output quality" Foreground="#C7C7C5" FontSize="11" Margin="0,10,0,0"/><ComboBox x:Name="QualityCombo" Height="34" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="QualityChanged"><ComboBoxItem Content="Standard · 30 fps" Tag="720p30"/><ComboBoxItem Content="Low bandwidth · 30 fps" Tag="480p30"/></ComboBox></StackPanel></Border>
                                <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="14"><StackPanel><DockPanel><TextBlock Text="04 / ENCODER" Foreground="#999A9E" FontSize="10"/><TextBlock x:Name="EncoderStatusText" Text="Waiting" Foreground="#C7C7C5" FontSize="10" HorizontalAlignment="Right" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Hardware first" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Media Foundation H.264, with x264 fallback." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="EngineErrorText" Foreground="#FF8790" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="DestinationsPage" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Destinations" FontSize="25" FontWeight="Bold"/><TextBlock Text="Set up RTMP outputs here. Select any saved destinations for the next broadcast." Foreground="#999A9E" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Start local RTMP test" Style="{StaticResource SecondaryButton}" Click="AddLocalRtmpClick" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="＋  Add destination" Style="{StaticResource PrimaryButton}" Click="AddDestinationClick" VerticalAlignment="Center"/></StackPanel></DockPanel>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12"><DockPanel><TextBlock Text="STREAM KEY SECURITY" Foreground="#F04455" FontSize="9" FontWeight="Bold" DockPanel.Dock="Left" Margin="0,0,12,0"/><TextBlock Text="Keys are encrypted for your Windows account. They are only passed to FFmpeg while a stream is active." Foreground="#C7C7C5" FontSize="11" TextWrapping="Wrap"/></DockPanel></Border>
                            <TextBlock x:Name="EmptyDestinationsText" Text="No destinations saved yet. Add a TikTok, YouTube, Twitch, or custom RTMP output." Foreground="#999A9E" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
                            <ItemsControl x:Name="DestinationProfileList"/>
                        </StackPanel>

                        <StackPanel x:Name="ScenesPage" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Scene library" FontSize="25" FontWeight="Bold"/><TextBlock Text="Build a set, save reusable layouts, and switch live from the desk." Foreground="#999A9E" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Save as template" Style="{StaticResource SecondaryButton}" Click="SaveActiveAsTemplateClick" VerticalAlignment="Center" Margin="0,0,8,0"/><Button Content="＋  New scene" Style="{StaticResource PrimaryButton}" Click="AddSceneClick" VerticalAlignment="Center"/></StackPanel></DockPanel>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,15"><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="SCENE SETUPS" Foreground="#F04455" FontSize="9" FontWeight="Bold"/><TextBlock Text="Create scenes for landscape or vertical streams, then make one active on your live desk." Foreground="#C7C7C5" FontSize="11" TextWrapping="Wrap" Margin="0,5,14,0"/></StackPanel><TextBlock x:Name="SceneCountText" Text="0 scenes" Foreground="#999A9E" FontSize="10" VerticalAlignment="Center" DockPanel.Dock="Right"/></DockPanel></Border>
                            <TextBlock Text="YOUR SCENES · DRAG TO REORDER" Foreground="#999A9E" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,9"/>
                            <ItemsControl x:Name="SceneCardList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,3,0,14">
                                <StackPanel>
                                    <DockPanel><StackPanel><TextBlock Text="SOURCE LAYERS" Foreground="#F04455" FontSize="10" FontWeight="Bold"/><TextBlock Text="Drag a layer to change its depth. The top row appears in front." Foreground="#999A9E" FontSize="10" Margin="0,4,0,0"/></StackPanel><TextBlock Text="FRONT ↑" Foreground="#C7C7C5" FontSize="9" VerticalAlignment="Center" DockPanel.Dock="Right"/></DockPanel>
                                    <ItemsControl x:Name="SceneLayerList" AllowDrop="True" DragOver="SceneLayerDragOver" Drop="SceneLayerDrop" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="SceneLayerEmptyText" Text="Add a source to this scene to arrange its layers." Foreground="#999A9E" FontSize="10" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#21191C" BorderBrush="#71333E" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,3,0,0"><StackPanel><TextBlock Text="SCENE OUTPUT" Foreground="#FF6978" FontSize="9" FontWeight="Bold"/><TextBlock Text="The active scene is composed into your stream: desktop capture forms the base, with camera, image, and text sources layered on top. Vertical scenes use a 9:16 output canvas." Foreground="#C7C7C5" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border>
                        </StackPanel>

                        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
                            <TextBlock Text="Capture settings" FontSize="25" FontWeight="Bold"/><TextBlock Text="Choose what X Studio captures and which devices feed your scene." Foreground="#999A9E" FontSize="12" Margin="0,5,0,18"/>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,12">
                                <StackPanel><DockPanel><TextBlock Text="VIDEO INPUT" Foreground="#F04455" FontSize="10" FontWeight="Bold"/><Button Content="Refresh devices" Style="{StaticResource SecondaryButton}" Height="28" Click="RefreshInputsClick" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="LEGACY CAPTURE FALLBACK" FontSize="10" Foreground="#999A9E" FontWeight="SemiBold" Margin="0,12,0,5"/><ComboBox x:Name="CaptureTargetCombo" Height="38" SelectionChanged="CaptureTargetChanged"/><TextBlock Text="Use Add Source in a scene to choose Full display or an individual open app. This fallback only serves older scenes without scene capture layers." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,14"/><TextBlock Text="Camera" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="SettingsCameraCombo" Height="38" SelectionChanged="CameraDeviceChanged"/><TextBlock Text="Choose the camera device here, then add one or more Camera layers to each scene." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,12">
                                <StackPanel><TextBlock Text="PHONE CAST" Foreground="#F04455" FontSize="10" FontWeight="Bold"/><TextBlock Text="Add a Phone source to a scene, then start its receiver here." Foreground="#999A9E" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,12"/><WrapPanel><Button Content="Connect Android · USB" Style="{StaticResource SecondaryButton}" Click="StartAndroidCastClick" Margin="0,0,8,8"/><Button Content="Start iPhone · AirPlay" Style="{StaticResource SecondaryButton}" Click="StartIPhoneCastClick" Margin="0,0,8,8"/><Button Content="Stop phone receivers" Style="{StaticResource SecondaryButton}" Click="StopPhoneCastClick" Margin="0,0,0,8"/></WrapPanel><TextBlock x:Name="PhoneCastStatus" Text="Android needs USB debugging. iPhone uses Apple's Bonjour service; if it is missing, X Studio downloads it from Apple and asks for admin approval. Keep both devices on the same Wi-Fi." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            </Border>
                            <Border Background="#191A1D" BorderBrush="#38393F" BorderThickness="1" CornerRadius="10" Padding="17">
                                <StackPanel><TextBlock Text="AUDIO INPUT" Foreground="#F04455" FontSize="10" FontWeight="Bold"/><DockPanel Margin="0,11,0,5"><TextBlock Text="Microphone" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><CheckBox x:Name="SettingsMicEnabled" Content="Include in stream" IsChecked="True" DockPanel.Dock="Right" VerticalAlignment="Center" Checked="SettingsMicToggleChanged" Unchecked="SettingsMicToggleChanged"/></DockPanel><ComboBox x:Name="SettingsAudioCombo" Height="38" SelectionChanged="AudioDeviceChanged"/><DockPanel Margin="0,8,0,0"><Button Content="Test microphone" Style="{StaticResource SecondaryButton}" Height="28" Click="MicTestClick"/><TextBlock Text="Use the live desk meter while speaking." Foreground="#999A9E" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/></DockPanel><TextBlock Text="The mic is encoded into every selected destination. X Studio checks the selected input before starting." Foreground="#999A9E" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
                            </Border>
                            <TextBlock Text="Device changes save automatically and apply to the next broadcast." Foreground="#999A9E" FontSize="10" Margin="2,12,0,0"/>
                        </StackPanel>

                        <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                            <TextBlock Text="Engine status" FontSize="25" FontWeight="Bold"/><TextBlock Text="FFmpeg captures a full desktop or selected app window, composites the active scene, and sends one encode to selected RTMP outputs." Foreground="#999A9E" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,18"/>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel><TextBlock Text="CURRENT BUILD" Foreground="#F04455" FontSize="10" FontWeight="Bold"/><TextBlock Text="Wide or vertical canvas · Desktop/window capture · Camera, image, and text layers · Android USB and iPhone AirPlay inputs · Microphone · Shared multistream encode" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock Text="Next engine work: decoded live preview, desktop audio mix, and the community extension API." Foreground="#999A9E" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>

